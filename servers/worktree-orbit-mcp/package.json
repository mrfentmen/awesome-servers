{
  "name": "worktree-orbit-mcp",
  "version": "1.0.1",
  "description": "Aggregate local Git worktree topology without exposing repository content. Tools include inspect worktree topology",
  "type": "module",
  "mcpName": "io.github.mrfentmen/worktree-orbit-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/worktree-orbit-mcp.git"
  },
  "bin": {
    "worktree-orbit-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node test-orbit.mjs",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "git",
    "worktree",
    "topology",
    "local-first"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
