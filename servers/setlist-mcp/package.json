{
  "name": "@mrfentmen/setlist-mcp",
  "version": "1.0.2",
  "description": "Use this MCP server to Setlist.fm, concert setlists, songs played live, tour history. Tools include search artist, get artist setlists, get setlist detail",
  "type": "module",
  "mcpName": "io.github.mrfentmen/setlist-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/setlist-mcp.git"
  },
  "bin": {
    "setlist-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "setlist",
    "concerts",
    "music",
    "tours",
    "live"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
