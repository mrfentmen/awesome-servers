{
  "name": "vapi-mcp",
  "version": "1.0.0",
  "description": "Query the Vapi API (free tier key; set VAPI_API_KEY, Bearer): assistants, single assistant, call history, call details.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/vapi-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/awesome-servers.git"
  },
  "bin": {
    "vapi-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "vapi",
    "voice",
    "agents",
    "calls"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
