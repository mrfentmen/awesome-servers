{
  "name": "statuspage-mcp",
  "version": "1.0.0",
  "description": "Query Statuspage management API (key; set STATUSPAGE_API_KEY, OAuth header): pages, page details, incidents. (Public per-page v2 is keyless but page-scoped; this covers management reads.)",
  "type": "module",
  "mcpName": "io.github.mrfentmen/statuspage-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/premium-mcps.git"
  },
  "bin": {
    "statuspage-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "statuspage",
    "status",
    "incidents",
    "devops"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
