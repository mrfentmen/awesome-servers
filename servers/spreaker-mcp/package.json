{
  "name": "spreaker-mcp",
  "version": "1.0.1",
  "description": "Query the Spreaker podcast platform: get shows and episodes, list a show's episodes, search public shows (no key needed), and create shows with an OAuth token (SPREAKER_ACCESS_TOKEN).",
  "type": "module",
  "mcpName": "io.github.mrfentmen/spreaker-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/premium-mcps.git"
  },
  "bin": {
    "spreaker-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "spreaker",
    "podcast",
    "shows",
    "episodes"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
