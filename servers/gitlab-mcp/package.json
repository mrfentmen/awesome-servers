{
  "name": "@mrfentmen/gitlab-mcp",
  "version": "1.1.0",
  "description": "Query GitLab (token; set GITLAB_PRIVATE_TOKEN, PRIVATE-TOKEN header; optional GITLAB_BASE_URL for self-host): profile, projects, groups, public search.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/gitlab-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/awesome-servers.git"
  },
  "bin": {
    "gitlab-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "gitlab",
    "git",
    "devops",
    "repos"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
