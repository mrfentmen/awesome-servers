{
  "name": "@mrfentmen/stripe-mcp",
  "version": "1.1.0",
  "description": "Query the Stripe API (test-mode key; set STRIPE_SECRET_KEY, Basic): charges, customers, balance. Use test keys only.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/stripe-mcp",
  "repository": {
    "type": "git",
