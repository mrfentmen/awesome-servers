{
  "name": "@mrfentmen/supabase-mcp",
  "version": "1.1.1",
  "description": "Query your Supabase project (set SUPABASE_URL + SUPABASE_SERVICE_KEY, apikey header): table rows, auth users, RPC. Endpoints per official docs.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/supabase-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/premium-mcps.git"
  },
  "bin": {
    "supabase-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "supabase",
    "postgres",
    "database",
    "backend"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
