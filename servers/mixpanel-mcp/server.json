{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mrfentmen/mixpanel-mcp",
  "description": "Query Mixpanel events, funnels, retention, cohorts, and user profiles.",
  "repository": {
    "url": "https://github.com/mrfentmen/mixpanel-mcp",
    "source": "github"
  },
  "version": "1.0.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mrfentmen/mixpanel-mcp",
      "version": "1.0.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MIXPANEL_TOKEN",
          "description": "Your Mixpanel project token",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "MIXPANEL_API_SECRET",
          "description": "Your Mixpanel API secret",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
