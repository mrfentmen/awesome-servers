{
  "name": "@mrfentmen/steam-mcp",
  "version": "1.0.1",
  "description": "Use this MCP server to Steam, store search, prices and discounts, app details, and game news. Tools include search games, get game details, get game news",
  "type": "module",
  "mcpName": "io.github.mrfentmen/steam-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/steam-mcp.git"
  },
  "bin": {
    "steam-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "steam",
    "games",
    "prices",
    "store",
    "deals"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
