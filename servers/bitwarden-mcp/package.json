{
  "name": "@mrfentmen/bitwarden-mcp",
  "version": "1.0.1",
  "description": "Bitwarden public API: organization members, collections, groups, event logs. Needs API key.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/bitwarden-mcp",
  "repository": {
    "type": "git",
