{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mrfentmen/invoice-mcp",
  "description": "Generate and send invoices across carriers (UPS, USPS, FedEx, DHL).",
  "repository": {
    "url": "https://github.com/mrfentmen/awesome-servers",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "invoice-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "UPS_API_KEY",
          "description": "UPS API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "USPS_API_KEY",
          "description": "USPS API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "FEDEX_API_KEY",
          "description": "FedEx API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "DHL_API_KEY",
          "description": "DHL API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
