{
  "name": "@mrfentmen/postmark-mcp",
  "version": "1.0.0",
  "description": "Query the Postmark API (free tier server token; set POSTMARK_SERVER_TOKEN, sent as X-Postmark-Server-Token): server info, templates, outbound messages.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/postmark-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/awesome-servers.git"
  },
  "bin": {
    "postmark-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "postmark",
    "email",
    "transactional",
    "marketing"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
