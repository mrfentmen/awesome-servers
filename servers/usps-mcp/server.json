{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mrfentmen/usps-mcp",
  "description": "USPS shipping, tracking, address validation, and label creation.",
  "repository": {
    "url": "https://github.com/mrfentmen/premium-mcps",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "usps-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "USPS_API_KEY",
          "description": "USPS API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "USPS_USERNAME",
          "description": "USPS username for basic auth",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "USPS_PASSWORD",
          "description": "USPS password for basic auth",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "USPS_API_URL",
          "description": "USPS API base URL (default: https://api.usps.com)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
