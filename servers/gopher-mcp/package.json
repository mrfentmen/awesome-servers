{
  "name": "@mrfentmen/gopher-mcp",
  "version": "1.0.2",
  "description": "Use this MCP server to the Gopher protocol, browse gopherspace, the pre HTTP internet. Menus, text files, Veronica search",
  "type": "module",
  "mcpName": "io.github.mrfentmen/gopher-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/gopher-mcp.git"
  },
  "bin": {
    "gopher-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "gopher",
    "retro",
    "internet",
    "textfiles",
    "protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
