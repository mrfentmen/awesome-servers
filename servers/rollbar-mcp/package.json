{
  "name": "rollbar-mcp",
  "version": "1.0.0",
  "description": "Query the Rollbar API (free tier token; set ROLLBAR_ACCESS_TOKEN, query param): projects, project items, item details.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/rollbar-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/awesome-servers.git"
  },
  "bin": {
    "rollbar-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "rollbar",
    "errors",
    "monitoring",
    "apm"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
