{
  "name": "@mrfentmen/cloudflare-mcp",
  "version": "1.1.0",
  "description": "Query Cloudflare v4 (API token; set CLOUDFLARE_API_TOKEN, Bearer): zones, accounts, DNS records.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/cloudflare-mcp",
  "repository": {
    "type": "git",
