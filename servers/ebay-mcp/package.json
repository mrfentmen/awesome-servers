{
  "name": "@mrfentmen/ebay-mcp",
  "version": "1.1.0",
  "description": "Query the eBay Browse API (OAuth user token; set EBAY_OAUTH_TOKEN, Bearer): item search, item details. App keys alone cannot call Browse \u2014 a user token is required.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/ebay-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/premium-mcps.git"
  },
  "bin": {
    "ebay-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "ebay",
    "shopping",
    "search",
    "ecommerce"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
