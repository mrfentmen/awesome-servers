{
  "name": "wikisource-mcp",
  "version": "1.0.3",
  "description": "Use this MCP server to searching and reading public-domain texts on Wikisource. Tools include search texts, read text",
  "type": "module",
  "mcpName": "io.github.mrfentmen/wikisource-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/wikisource-mcp.git"
  },
  "bin": {
    "wikisource-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "wikisource",
    "public-domain",
    "primary-sources",
    "books"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
