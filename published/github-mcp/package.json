{
  "name": "@mrfentmen/github-mcp",
  "version": "1.1.4",
  "description": "Query the GitHub REST API (free token; set GITHUB_TOKEN, Bearer): profile, repos, repo details, code search.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/github-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/premium-mcps.git"
  },
  "bin": {
    "github-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "github",
    "git",
    "repos",
    "dev"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
