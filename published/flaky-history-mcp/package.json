{
  "name": "flaky-history-mcp",
  "version": "1.0.3",
  "description": "Local aggregate test-history stability analysis without test names or raw result contents. Tools include analyze test history",
  "type": "module",
  "mcpName": "io.github.mrfentmen/flaky-history-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/flaky-history-mcp.git"
  },
  "bin": {
    "flaky-history-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node test-history.mjs",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "testing",
    "flaky-tests",
    "ci",
    "local-first"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
