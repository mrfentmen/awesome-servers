  "description": "Search PublicWWW (paid API key; set PUBLICWWW_API_KEY): sites containing a snippet, URL export.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/publicwww-mcp",
  "repository": {
    "type": "git",
