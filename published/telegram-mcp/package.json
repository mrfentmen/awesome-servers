{
  "name": "@mrfentmen/telegram-mcp",
  "version": "1.1.2",
  "description": "Use the Telegram Bot API (free bot; set TELEGRAM_BOT_TOKEN): bot info, send messages, read updates. Sending is real \u2014 verify chat IDs.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/telegram-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/premium-mcps.git"
  },
  "bin": {
    "telegram-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "telegram",
    "bot",
    "messaging",
    "chat"
  ],
