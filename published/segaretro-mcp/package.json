{
  "name": "segaretro-mcp",
  "version": "1.0.4",
  "description": "Use this MCP server to Sega Retro, every Sega game, console, and unreleased hardware. Tools include search pages, get page, list category",
  "type": "module",
  "mcpName": "io.github.mrfentmen/segaretro-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/segaretro-mcp.git"
  },
  "bin": {
    "segaretro-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "sega",
    "retro",
    "wiki",
    "games"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
