{
  "name": "rawg-mcp",
  "version": "1.0.3",
  "description": "Query the RAWG video games database (free key from rawg.io/apidocs; set RAWG_API_KEY): game search and details with ratings, platforms, genres.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/rawg-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/premium-mcps.git"
  },
  "bin": {
    "rawg-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "games",
    "rawg",
    "videogames",
    "gaming"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
