{
  "name": "release-notes-forge-mcp",
  "version": "1.0.1",
  "description": "Summarize local Git release shape without returning commit messages, paths, hashes, or remotes.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/release-notes-forge-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrfentmen/awesome-servers.git"
  },
  "bin": {
    "release-notes-forge-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node test.mjs"
  },
  "keywords": [
    "mcp",
    "local-first",
    "read-only"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
