{
  "name": "typeform-mcp",
  "version": "1.1.4",
  "description": "Query Typeform (token; set TYPEFORM_TOKEN, Bearer): forms, form details, responses.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/typeform-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/premium-mcps.git"
  },
  "bin": {
    "typeform-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "typeform",
    "forms",
    "surveys",
    "responses"
  ],
  "license": "MIT",
