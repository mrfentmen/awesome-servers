{
  "name": "@mrfentmen/sentry-mcp",
  "version": "1.1.4",
  "description": "Query Sentry (auth token; set SENTRY_AUTH_TOKEN, Bearer): organizations, projects, issues.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/sentry-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/premium-mcps.git"
  },
  "bin": {
    "sentry-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "sentry",
    "errors",
    "monitoring",
    "apm"
