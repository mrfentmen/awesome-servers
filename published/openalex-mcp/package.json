{
  "name": "@mrfentmen/openalex-mcp",
  "version": "1.1.0",
  "description": "Use this MCP server to OpenAlex scholarly works, authors, institutions, and citations. Tools include search works, get work, search authors",
  "type": "module",
  "mcpName": "io.github.mrfentmen/openalex-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/openalex-mcp.git"
  },
  "bin": {
    "openalex-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "research",
    "papers",
    "openalex"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
