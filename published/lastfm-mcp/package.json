{
  "name": "lastfm-mcp",
  "version": "1.0.5",
  "description": "Query the Last.fm API (free key; set LASTFM_API_KEY, query param): top artists, top tracks, artist info.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/lastfm-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrfentmen/awesome-servers.git"
  },
  "bin": {
    "lastfm-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "lastfm",
    "music",
    "charts",
    "artists"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
