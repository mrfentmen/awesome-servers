{
  "name": "invoice-mcp",
  "version": "1.0.3",
  "description": "MCP server for generating, sending, and tracking invoices across carriers (UPS, USPS, FedEx, DHL).",
  "type": "module",
  "mcpName": "io.github.mrfentmen/invoice-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/premium-mcps.git"
  },
  "bin": {
    "invoice-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "/opt/homebrew/bin/tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && /opt/homebrew/bin/tsc -p tsconfig.json && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "invoice",
    "billing",
    "ups",
    "usps",
    "fedex",
    "dhl"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
