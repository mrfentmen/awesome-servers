{
  "name": "chempirical-mcp",
  "version": "1.0.0",
  "description": "MCP server for Chempirical: search 48,000 compounds, substructure and similarity search, reactions, Antoine constants and azeotropes. Keyless.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/chempirical-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrfentmen/awesome-servers.git"
  },
  "bin": {
    "chempirical-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chempirical"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
