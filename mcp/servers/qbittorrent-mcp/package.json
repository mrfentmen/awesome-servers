{
  "name": "qbittorrent-mcp",
  "version": "1.0.1",
  "description": "Query your qBittorrent WebUI (self-hosted; set QBITTORRENT_URL + QBITTORRENT_USER + QBITTORRENT_PASS; logs in per official API docs): torrents, transfer stats, app version.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/qbittorrent-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/premium-mcps.git"
  },
  "bin": {
    "qbittorrent-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "qbittorrent",
    "torrents",
    "downloads",
    "self-hosted"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
