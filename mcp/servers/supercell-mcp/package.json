{
  "name": "supercell-mcp",
  "version": "1.0.0",
  "description": "Supercell API: Clash of Clans and Clash Royale players, clans, rankings. Key is IP-bound.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/supercell-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/awesome-mcps.git"
  },
  "bin": {
    "supercell-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
