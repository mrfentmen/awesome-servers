{
  "name": "zork-mcp",
  "version": "1.0.0",
  "description": "MCP server that plays classic text adventure games. The LLM is the player, explore, solve puzzles, collect treasure.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/zork-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrfentmen/awesome-servers.git"
  },
  "bin": {
    "zork-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "zork",
    "text-adventure",
    "interactive-fiction",
    "games",
    "retro"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
