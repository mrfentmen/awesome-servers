{
  "name": "pubg-mcp",
  "version": "1.0.0",
  "description": "Official PUBG API: player lookup, match data, seasons, lifetime and seasonal stats.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/pubg-mcp",
  "repository": {
    "type": "git",
