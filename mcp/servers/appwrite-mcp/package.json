{
  "name": "appwrite-mcp",
  "version": "1.0.1",
  "description": "Query your Appwrite instance (self-hosted or cloud; set APPWRITE_ENDPOINT + APPWRITE_PROJECT + APPWRITE_API_KEY): users, databases. Endpoints per official docs.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/appwrite-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/premium-mcps.git"
  },
  "bin": {
    "appwrite-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "appwrite",
    "backend",
    "database",
    "self-hosted"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}