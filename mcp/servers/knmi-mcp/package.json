{
  "name": "knmi-mcp",
  "version": "1.0.0",
  "description": "KNMI Data Platform open data: datasets, versions, file listings and downloads (weather, climate, radar).",
  "type": "module",
  "mcpName": "io.github.mrfentmen/knmi-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/awesome-mcps.git"
  },
  "bin": {
    "knmi-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
