{
  "name": "docraptor-mcp",
  "version": "0.1.0",
  "description": "MCP server for the DocRaptor HTML-to-PDF/XLSX API: generate documents from HTML content or a URL, test mode by default. No paywall in the server itself.",
  "type": "module",
  "private": false,
  "bin": { "docraptor-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.0"
  },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
