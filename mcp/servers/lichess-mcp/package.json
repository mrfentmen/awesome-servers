{
  "name": "@mrfentmen/lichess-mcp",
  "version": "1.0.2",
  "description": "Use this MCP server to Lichess, chess puzzles by rating, player stats, and top players. Tools include get daily puzzle, get puzzle, get player",
  "type": "module",
  "mcpName": "io.github.mrfentmen/lichess-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/lichess-mcp.git"
  },
  "bin": {
    "lichess-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
