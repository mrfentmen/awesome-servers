  "description": "Query the Deepgram API (free tier key; set DEEPGRAM_API_KEY, sent as Token): projects, project balances, and API keys.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/deepgram-mcp",
  "repository": {
    "type": "git",
