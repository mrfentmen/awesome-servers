{
  "name": "8bitpeoples-mcp",
  "version": "1.0.1",
  "description": "Use this MCP server to 8bitpeoples, the free chiptune record label, browse the full release catalog. Tools include list releases, get release",
  "type": "module",
  "mcpName": "io.github.mrfentmen/8bitpeoples-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/8bitpeoples-mcp.git"
  },
  "bin": {
    "8bitpeoples-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "chiptune",
    "8bit",
    "music",
    "label"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
