{
  "name": "thegraph-mcp",
  "version": "1.0.0",
  "description": "The Graph decentralized network: run GraphQL against any subgraph via API-key gateway.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/thegraph-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/awesome-mcps.git"
  },
  "bin": {
    "thegraph-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "thegraph",
    "graphql",
    "web3",
    "indexing",
    "defi"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
