{
  "name": "@mrfentmen/lockstep-mcp",
  "version": "1.0.0",
  "description": "Local lockfile and package-manager reproducibility analysis without dependency details. Tools include inspect reproducibility",
  "type": "module",
  "mcpName": "io.github.mrfentmen/lockstep-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/lockstep-mcp.git"
  },
  "bin": {
    "lockstep-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "lockfile",
    "reproducibility",
    "package-manager",
    "local-first"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
