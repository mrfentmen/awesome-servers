{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mrfentmen/gimp-mcp",
  "description": "Control GIMP image editing via Python-Fu scripting from AI agents.",
  "repository": {
    "url": "https://github.com/mrfentmen/gimp-mcp",
    "source": "github"
  },
  "version": "1.0.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "gimp-mcp",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GIMP_PATH",
          "description": "Path to GIMP executable (default: /usr/bin/gimp)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
