{
  "name": "edrv-mcp",
  "version": "1.0.0",
  "description": "MCP server for eDRV: charging stations, connectors, remote commands, reservations, transactions and vehicles.",
  "type": "module",
  "mcpName": "io.github.mrfentmen/edrv-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrfentmen/awesome-servers.git"
  },
  "bin": {
    "edrv-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "test": "npm run build && node --test tests/tools.test.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "edrv"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
