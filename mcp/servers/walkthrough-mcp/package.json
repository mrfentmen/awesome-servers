{
  "name": "@mrfentmen/walkthrough-mcp",
  "version": "1.0.0",
  "description": "Use this MCP server to retro game walkthroughs, FAQs, and cheats, backed by StrategyWiki's open MediaWiki API",
  "type": "module",
  "mcpName": "io.github.mrfentmen/walkthrough-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/walkthrough-mcp.git"
  },
  "bin": {
    "walkthrough-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && tsc -p tsconfig.json && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "walkthrough",
    "cheats",
    "strategy",
    "guides",
    "gaming",
    "retro"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
