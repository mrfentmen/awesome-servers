# 7Timer Stargazing A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8816
A2A_PUBLIC_URL=http://127.0.0.1:8816
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# Keyless. 7Timer's astronomical product needs no account, so every free skill
# works with nothing set here. It is a model run, not an observation: each slot
# is a forecast, and the product carries no daylight flag and no moon phase.
STARGAZING_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
STARGAZING_BASE_URL=https://www.7timer.info
# The run is republished on 7Timer's own schedule, so half an hour is plenty.
STARGAZING_CACHE_TTL=1800
STARGAZING_HTTP_TIMEOUT=30

# --- premium skills (sky-best-window) ----------------------------------------
# sky-best-window scores every 3-hour slot and ranks the contiguous runs worth
# going out for. It runs on the licence gateway, which checks a Polar key before
# doing the work, so this key is what unlocks it. Every other skill on this
# server stays free and keyless.
MCP_LICENSE_KEY=
# Endpoint override. `a2a_kit.GatewayClient` is constructed with its default env
# prefix, so A2A_GATEWAY_URL is the variable it actually reads; this per-server
# name is here so the setting sits with the rest of this server.
A2A_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp
STARGAZING_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
STARGAZING_DB=./servers/stargazing/data/tasks.db
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
STARGAZING_ALLOW_PRIVATE_WEBHOOKS=0
