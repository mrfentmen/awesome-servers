# NYC drinking water (DEP monitoring) A2A server — copy to .env and export.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8789
A2A_PUBLIC_URL=http://127.0.0.1:8789
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- dataset access ----------------------------------------------------------
NYC_WATER_APP_TOKEN=
NYC_WATER_BASE_URL=https://data.cityofnewyork.us
NYC_WATER_CACHE_TTL=60
NYC_WATER_HTTP_TIMEOUT=20

# --- premium skills (water-trend) --------------------------------------------
# water-trend does not read the dataset here. It runs on the licence gateway, which
# checks a Polar key before doing the work, so this key is what unlocks it. Every
# other skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
NYC_WATER_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
NYC_WATER_DB=./servers/nycwater/data/tasks.db
# Seconds between new-sample watches. The dataset is updated daily.
NYC_WATER_WATCH_INTERVAL=3600
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
NYC_WATER_ALLOW_PRIVATE_WEBHOOKS=0
