# iNaturalist Species A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8815
A2A_PUBLIC_URL=http://127.0.0.1:8815
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# Keyless. iNaturalist's public observation endpoint needs no account, so every
# free skill works with nothing set here. It is a crowd-sourced dataset: a row
# is one uploaded observation, not one animal, and the grade on that row says
# whether the community confirmed the identification.
SPECIES_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
SPECIES_BASE_URL=https://api.inaturalist.org/v1
# Observations arrive continuously, so a short cache only smooths a burst.
SPECIES_CACHE_TTL=300
SPECIES_HTTP_TIMEOUT=20

# --- premium skills (range-survey) -------------------------------------------
# range-survey pages through a name's observations and counts their shape. It
# runs on the licence gateway, which checks a Polar key before doing the work,
# so this key is what unlocks it. Every other skill on this server stays free.
# Endpoint override. `a2a_kit.GatewayClient` is constructed with its default env
# name is here so the setting sits with the rest of this server.

# --- state -------------------------------------------------------------------
SPECIES_DB=./servers/species/data/tasks.db
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
SPECIES_ALLOW_PRIVATE_WEBHOOKS=0
