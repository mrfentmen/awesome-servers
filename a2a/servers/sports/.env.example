# ESPN sports A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8807
A2A_PUBLIC_URL=http://127.0.0.1:8807
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# No key. `site.api.espn.com` answers HTTP 403 to every caller, so the base URL is the
# `site.web.` host, which serves the same documents.
ESPN_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
ESPN_BASE_URL=https://site.web.api.espn.com
ESPN_CACHE_TTL=60
ESPN_HTTP_TIMEOUT=20

# --- premium skills (slate-brief) --------------------------------------------
# slate-brief does not read ESPN here. It runs on the licence gateway, which checks a
# Polar key before doing the work, so this key is what unlocks it. Every other skill on
# this server stays free and keyless.
# Point at a local `wrangler dev` while testing the gateway.

# --- state -------------------------------------------------------------------
ESPN_DB=./servers/sports/data/tasks.db
