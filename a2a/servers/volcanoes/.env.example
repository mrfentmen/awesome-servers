[TEMPLATE]
# USGS volcano alert-level A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8798
A2A_PUBLIC_URL=http://127.0.0.1:8798
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# The Volcano Science Center API needs no key; this is just how you identify yourself.
VOLCANO_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
VOLCANO_BASE_URL=https://volcanoes.usgs.gov
# Alert levels change by observatory decision, not by the minute: 15 minutes is plenty.
VOLCANO_CACHE_TTL=900
# The VSC API is slow (measured 12-76s for the same geojson read on 2026-09-23).
VOLCANO_HTTP_TIMEOUT=90

# --- premium skills (volcano-threat) -----------------------------------------
# volcano-threat does not read the catalogue here. It runs on the licence gateway,
# which checks a Polar key before doing the work, so this key is what unlocks it.
# Every other skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
VOLCANO_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
VOLCANO_DB=./servers/volcanoes/data/tasks.db
# A watch reads a cached 116 KB listing; every 30 minutes is polite and enough.
VOLCANO_WATCH_INTERVAL=1800
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
VOLCANO_ALLOW_PRIVATE_WEBHOOKS=0
