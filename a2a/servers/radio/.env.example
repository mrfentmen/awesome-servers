# radio-browser A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8806
A2A_PUBLIC_URL=http://127.0.0.1:8806
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# radio-browser needs no key and publishes several mirrors; any of them answers the
# same API. Swap this if one is slow.
RADIO_BROWSER_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
RADIO_BROWSER_BASE_URL=https://de1.api.radio-browser.info
RADIO_BROWSER_CACHE_TTL=600
RADIO_BROWSER_HTTP_TIMEOUT=20
# Stream health is re-checked by the mirror on its own schedule: keep it short.
RADIO_BROWSER_HEALTH_TTL=300

# --- premium skills (station-roster) -----------------------------------------
# station-roster does not query radio-browser here. It runs on the licence gateway,
# which checks a Polar key before doing the work, so this key is what unlocks it.
# Every other skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
RADIO_BROWSER_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
RADIO_BROWSER_DB=./servers/radio/data/tasks.db
