# USGS earthquake A2A server — copy to .env and export.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8792
A2A_PUBLIC_URL=http://127.0.0.1:8792
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# USGS asks heavy users to identify themselves; override this in production.
USGS_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
USGS_BASE_URL=https://earthquake.usgs.gov
USGS_CACHE_TTL=60
USGS_HTTP_TIMEOUT=20

# --- premium skills (quakes-aftershocks) -------------------------------------
# quakes-aftershocks does not count the sequence here. It runs on the licence
# gateway, which checks a Polar key before doing the work, so this key is what
# unlocks it. Every other skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
USGS_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
USGS_DB=./servers/quakes/data/tasks.db
# Earthquakes are continuous, so a 60s watch keeps alerts timely without hammering USGS.
USGS_WATCH_INTERVAL=60
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
USGS_ALLOW_PRIVATE_WEBHOOKS=0
