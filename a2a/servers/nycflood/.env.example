# NYC street-flooding (FloodNet) A2A server — copy to .env and export.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8788
A2A_PUBLIC_URL=http://127.0.0.1:8788
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- dataset access ----------------------------------------------------------
NYC_FLOOD_APP_TOKEN=
NYC_FLOOD_BASE_URL=https://data.cityofnewyork.us
NYC_FLOOD_CACHE_TTL=60
NYC_FLOOD_HTTP_TIMEOUT=20

# --- premium skills (flood-hotspots) -----------------------------------------
# flood-hotspots does not read the datasets here. It runs on the licence gateway,
# which checks a Polar key before doing the work, so this key is what unlocks it.
# Every other skill on this server stays free and keyless.
# Point at a local `wrangler dev` while testing the gateway.

# --- state -------------------------------------------------------------------
NYC_FLOOD_DB=./servers/nycflood/data/tasks.db
# Seconds between flood-event watches. FloodNet events are sparse; 300 is fine.
NYC_FLOOD_WATCH_INTERVAL=300
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
NYC_FLOOD_ALLOW_PRIVATE_WEBHOOKS=0
