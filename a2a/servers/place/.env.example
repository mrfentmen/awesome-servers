# Postal code A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8873
A2A_PUBLIC_URL=http://127.0.0.1:8873
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream APIs -----------------------------------------------------------
# Both feeds are keyless. postcodes.io is the UK (ONS Open Postcode Directory);
# zippopotam covers about 65 other countries and not the UK.
PLACE_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
PLACE_BASE_URL=https://api.postcodes.io
PLACE_WORLD_BASE_URL=https://api.zippopotam.us
# Postcode geography is fixed and only additions land, so a day-long cache is safe.
PLACE_CACHE_TTL=900
PLACE_CATALOGUE_TTL=86400
PLACE_HTTP_TIMEOUT=20

# --- premium skills (catchment-area) -----------------------------------------
# catchment-area does not read postcodes.io here. It runs on the licence gateway,
# which checks a Polar key before doing the work, so this key is what unlocks it.
# Every other skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
PLACE_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
PLACE_DB=./servers/place/data/tasks.db
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
PLACE_ALLOW_PRIVATE_WEBHOOKS=0
