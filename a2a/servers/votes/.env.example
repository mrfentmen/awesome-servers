# GovTrack votes A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8854
A2A_PUBLIC_URL=http://127.0.0.1:8854
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# GovTrack's API v2 is keyless. Override the User-Agent with your own contact.
VOTES_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
VOTES_BASE_URL=https://www.govtrack.us/api/v2
# Votes and bills are recorded as they happen; committees and roles change slowly.
VOTES_CACHE_TTL=300
VOTES_HTTP_TIMEOUT=20

# --- premium skills (chamber-scorecard) ---------------------------------------
# chamber-scorecard does not read GovTrack here. It runs on the licence gateway,
# which checks a Polar key before doing the work, so this key is what unlocks it.
# Every other skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
VOTES_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
VOTES_DB=./servers/votes/data/tasks.db
