# openFDA recalls A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8796
A2A_PUBLIC_URL=http://127.0.0.1:8796
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# openFDA needs no key. An optional key raises the rate limit to 240 requests/min.
OPENFDA_API_KEY=
OPENFDA_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_CACHE_TTL=60
OPENFDA_HTTP_TIMEOUT=20

# --- premium skills (recall-trend) -------------------------------------------
# recall-trend does not count openFDA here. It runs on the licence gateway, which
# checks a Polar key before doing the work, so this key is what unlocks it. Every
# other skill on this server stays free and keyless.
# Point at a local `wrangler dev` while testing the gateway.

# --- state -------------------------------------------------------------------
OPENFDA_DB=./servers/recalls/data/tasks.db
# openFDA publishes on business days, so an hourly watch is plenty.
OPENFDA_WATCH_INTERVAL=3600
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
OPENFDA_ALLOW_PRIVATE_WEBHOOKS=0
