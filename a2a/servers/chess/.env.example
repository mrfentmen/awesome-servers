# Lichess A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8808
A2A_PUBLIC_URL=http://127.0.0.1:8808
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# No key, and no account: the public API is anonymous. Lichess throttles anonymous
# callers, so keep the cache warm rather than raising this.
LICHESS_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
LICHESS_BASE_URL=https://lichess.org
LICHESS_CACHE_TTL=300
LICHESS_HTTP_TIMEOUT=20

# --- premium skills (player-form) --------------------------------------------
# player-form does not read the game list here. It runs on the licence gateway, which
# checks a Polar key before doing the work, so this key is what unlocks it. Every other
# skill on this server stays free and keyless.
# Point at a local `wrangler dev` while testing the gateway.

# --- state -------------------------------------------------------------------
LICHESS_DB=./servers/chess/data/tasks.db
