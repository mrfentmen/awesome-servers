# GLEIF companies A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8851
A2A_PUBLIC_URL=http://127.0.0.1:8851
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# GLEIF's v1 API is keyless. Override the User-Agent with your own contact.
COMPANIES_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
COMPANIES_BASE_URL=https://api.gleif.org/api/v1
# The Golden Copy is republished daily, so a long cache is honest.
COMPANIES_CACHE_TTL=3600
COMPANIES_HTTP_TIMEOUT=20

# --- premium skills (group-rollup) --------------------------------------------
# group-rollup does not read GLEIF here. It runs on the licence gateway, which checks
# a Polar key before doing the work, so this key is what unlocks it. Every other
# skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
COMPANIES_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
COMPANIES_DB=./servers/companies/data/tasks.db
