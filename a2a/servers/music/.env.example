# Deezer music A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8805
A2A_PUBLIC_URL=http://127.0.0.1:8805
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# Deezer needs no key. It rate-limits anonymous callers, so keep the cache warm
# rather than raising this: a long TTL is the only lever an anonymous caller has.
DEEZER_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
DEEZER_BASE_URL=https://api.deezer.com
DEEZER_CACHE_TTL=900
DEEZER_HTTP_TIMEOUT=20

# --- premium skills (artist-timeline) ----------------------------------------
# artist-timeline does not read Deezer here. It runs on the licence gateway, which
# checks a Polar key before doing the work, so this key is what unlocks it. Every
# other skill on this server stays free and keyless.
# Point at a local `wrangler dev` while testing the gateway.

# --- state -------------------------------------------------------------------
DEEZER_DB=./servers/music/data/tasks.db
