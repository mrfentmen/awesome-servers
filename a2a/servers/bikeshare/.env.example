# Citi Bike A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8872
A2A_PUBLIC_URL=http://127.0.0.1:8872
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# Citi Bike's GBFS feeds are keyless. Each document is about a megabyte, so the
# status document is cached for half a minute and the locations for a day.
BIKESHARE_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
BIKESHARE_BASE_URL=https://gbfs.citibikenyc.com/gbfs/en
BIKESHARE_CACHE_TTL=30
BIKESHARE_STATUS_TTL=30
BIKESHARE_INFORMATION_TTL=86400
BIKESHARE_HTTP_TIMEOUT=20

# --- premium skills (ride-pair) ----------------------------------------------
# ride-pair does not read the GBFS feeds here. It runs on the licence gateway, which
# checks a Polar key before doing the work, so this key is what unlocks it. Every
# other skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
BIKESHARE_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
BIKESHARE_DB=./servers/bikeshare/data/tasks.db
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
BIKESHARE_ALLOW_PRIVATE_WEBHOOKS=0
