# MBTA A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8870
A2A_PUBLIC_URL=http://127.0.0.1:8870
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# The MBTA v3 API is keyless. An unauthenticated caller is rate limited, so the
# live feeds are cached briefly and the line catalogue for a day.
MBTA_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
MBTA_BASE_URL=https://api-v3.mbta.com
MBTA_CACHE_TTL=120
MBTA_LIVE_TTL=120
MBTA_CATALOGUE_TTL=900
MBTA_ROUTE_TTL=86400
# The schedules endpoint ignores filter[min_time], so a whole service day is fetched
# at once and sliced here. 500 is the agency's own page cap.
MBTA_SCHEDULE_LIMIT=500
MBTA_HTTP_TIMEOUT=20

# --- premium skills (headway-check) ------------------------------------------
# headway-check does not read the prediction feed here. It runs on the licence
# gateway, which checks a Polar key before doing the work, so this key is what
# unlocks it. Every other skill on this server stays free and keyless.
# Point at a local `wrangler dev` while testing the gateway.

# --- state -------------------------------------------------------------------
MBTA_DB=./servers/mbta/data/tasks.db
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
MBTA_ALLOW_PRIVATE_WEBHOOKS=0
