# CourtListener A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8850
A2A_PUBLIC_URL=http://127.0.0.1:8850
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# CourtListener's v4 REST API is keyless. Override the User-Agent with your own
# contact so Free Law Project can reach you if they need to.
COURTS_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
COURTS_BASE_URL=https://www.courtlistener.com/api/rest/v4
COURTS_CACHE_TTL=300
COURTS_HTTP_TIMEOUT=20
# The court list changes rarely: cache it for a day.
COURTS_COURT_TTL=86400

# --- premium skills (citation-census) -----------------------------------------
# citation-census does not read CourtListener here. It runs on the licence gateway,
# which checks a Polar key before doing the work, so this key is what unlocks it.
# Every other skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
COURTS_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
COURTS_DB=./servers/courts/data/tasks.db
