# GB grid carbon A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8874
A2A_PUBLIC_URL=http://127.0.0.1:8874
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# National Grid ESO's carbon intensity API is keyless. It publishes half-hourly, in
# UTC, and /regional only ever holds the current half-hour.
GRID_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
GRID_BASE_URL=https://api.carbonintensity.org.uk
GRID_CACHE_TTL=60
GRID_LIVE_TTL=60
GRID_REGIONAL_TTL=60
# The 24 hours behind us do not change, so a measured read is cached for an hour.
GRID_HISTORY_TTL=3600
GRID_HTTP_TIMEOUT=20

# --- premium skills (clean-windows) ------------------------------------------
# clean-windows does not read the forecast here. It runs on the licence gateway, which
# checks a Polar key before doing the work, so this key is what unlocks it. Every other
# skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
GRID_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
GRID_DB=./servers/grid/data/tasks.db
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
GRID_ALLOW_PRIVATE_WEBHOOKS=0
