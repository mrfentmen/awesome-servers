# TVMaze A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8804
A2A_PUBLIC_URL=http://127.0.0.1:8804
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# TVMaze needs no key and no sign-up; it only asks callers to look like a client.
TVMAZE_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
TVMAZE_BASE_URL=https://api.tvmaze.com
TVMAZE_CACHE_TTL=60
TVMAZE_HTTP_TIMEOUT=20
# The daily schedule is the only read that moves during a day, so it gets its own TTL.
TVMAZE_SCHEDULE_TTL=300

# --- premium skills (binge-plan) ---------------------------------------------
# binge-plan does not read TVMaze here. It runs on the licence gateway, which checks
# a Polar key before doing the work, so this key is what unlocks it. Every other
# skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
TVMAZE_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
TVMAZE_DB=./servers/tv/data/tasks.db
