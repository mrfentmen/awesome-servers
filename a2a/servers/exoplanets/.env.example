# NASA Exoplanet Archive A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8814
A2A_PUBLIC_URL=http://127.0.0.1:8814
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# Keyless. The archive is a TAP service: this server sends ad-hoc SELECTs against
# the pscomppars composite table and reads them back as JSON. It is a scientific
# catalogue assembled from the literature, not a count of planets that exist.
EXOPLANETS_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
EXOPLANETS_BASE_URL=https://exoplanetarchive.ipac.caltech.edu
EXOPLANETS_CACHE_TTL=3600
# TAP runs ad-hoc queries, so allow a longer timeout than a plain JSON API.
EXOPLANETS_HTTP_TIMEOUT=60
# The archive is republished as papers are accepted; an hour is plenty for a
# single planet or a bounded search.
EXOPLANETS_CATALOG_TTL=3600
# A full-table read is about half a megabyte of JSON, so it is cached much harder.
EXOPLANETS_TABLE_TTL=21600

# --- premium skills (catalogue-survey) ---------------------------------------
# catalogue-survey does not read the whole table here. It runs on the licence
# gateway, which checks a Polar key before doing the work, so this key is what
# unlocks it. Every other skill on this server stays free and keyless.
# Endpoint override. `a2a_kit.GatewayClient` is constructed with its default env
# name is here so the setting sits with the rest of this server.

# --- state -------------------------------------------------------------------
EXOPLANETS_DB=./servers/exoplanets/data/tasks.db
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
EXOPLANETS_ALLOW_PRIVATE_WEBHOOKS=0
