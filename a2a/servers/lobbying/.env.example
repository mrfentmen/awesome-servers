# Senate lobbying A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8853
A2A_PUBLIC_URL=http://127.0.0.1:8853
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# The Senate's Lobbying Disclosure Act API is keyless. Note that lda.senate.gov
# redirects to lda.gov; the base below is the one the redirect lands on.
LOBBYING_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
LOBBYING_BASE_URL=https://lda.gov/api/v1
# Filings are posted daily and never revised once posted.
LOBBYING_CACHE_TTL=900
LOBBYING_HTTP_TIMEOUT=20

# --- premium skills (client-spend) --------------------------------------------
# client-spend does not read LDA here. It runs on the licence gateway, which checks
# a Polar key before doing the work, so this key is what unlocks it. Every other
# skill on this server stays free and keyless.
# Point at a local `wrangler dev` while testing the gateway.

# --- state -------------------------------------------------------------------
LOBBYING_DB=./servers/lobbying/data/tasks.db
