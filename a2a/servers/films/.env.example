[TEMPLATE]
# Films (Wikidata + Internet Archive) A2A server — copy to .env and export, or pass real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8877
A2A_PUBLIC_URL=http://127.0.0.1:8877
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream sources --------------------------------------------------------
# Wikidata's query service and the Internet Archive are both keyless; this is how you
# identify yourself, and Wikidata asks for a contactable agent.
FILMS_USER_AGENT=a2a-films/1.0 (+https://github.com/mrfentmen/a2a)
# A SPARQL answer is expensive upstream and Wikidata's facts move slowly; 15 minutes is polite.
FILMS_CACHE_TTL=900
# Wikidata answers in about a second when it is warm, but its query service times out under
# load, so give it more room than a plain JSON API.
FILMS_HTTP_TIMEOUT=40

# --- premium skill (film-index) ----------------------------------------------
# film-index does not read the Archive here. It runs on the licence gateway, which checks
# a Polar key before doing the work, so this key is what unlocks it. Every other skill on
# this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
FILMS_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
FILMS_DB=./servers/films/data/tasks.db
