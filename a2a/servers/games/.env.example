[TEMPLATE]
# Games (Steam + SteamSpy + Epic) A2A server — copy to .env and export, or pass real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8876
A2A_PUBLIC_URL=http://127.0.0.1:8876
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream feeds ----------------------------------------------------------
# Steam, SteamSpy and Epic are all keyless; this is just how you identify yourself.
GAMES_USER_AGENT=a2a-games/1.0 (+https://github.com/mrfentmen/a2a)
# Steam prices and Epic windows move hourly; five minutes keeps repeat questions cheap.
GAMES_CACHE_TTL=300
GAMES_HTTP_TIMEOUT=25

# --- premium skill (price-board) ---------------------------------------------
# price-board does not read Steam here. It runs on the licence gateway, which checks a
# Polar key before doing the work, so this key is what unlocks it. Every other skill on
# this server stays free and keyless.
# Point at a local `wrangler dev` while testing the gateway.

# --- state -------------------------------------------------------------------
GAMES_DB=./servers/games/data/tasks.db
