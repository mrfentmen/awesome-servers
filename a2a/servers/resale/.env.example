# Designer resale (Fashionphile + Rebag) A2A server — copy to .env and export, or pass real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8875
A2A_PUBLIC_URL=http://127.0.0.1:8875
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream catalogues -----------------------------------------------------
# Both storefronts are keyless Shopify catalogues; this is just how you identify yourself.
RESALE_USER_AGENT=a2a-resale/1.0 (+https://github.com/mrfentmen/a2a)
# Asking prices move slowly and a catalogue page is 250 products, so 10 minutes of cache
# is already polite. Keep it above the page read cost.
RESALE_CACHE_TTL=600
RESALE_HTTP_TIMEOUT=25

# --- premium skill (price-index) ---------------------------------------------
# price-index does not read the catalogues here. It runs on the licence gateway,
# which checks a Polar key before doing the work, so this key is what unlocks it.
# Every other skill on this server stays free and keyless.
# Point at a local `wrangler dev` while testing the gateway.

# --- state -------------------------------------------------------------------
RESALE_DB=./servers/resale/data/tasks.db
