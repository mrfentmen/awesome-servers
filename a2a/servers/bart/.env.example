# BART A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8871
A2A_PUBLIC_URL=http://127.0.0.1:8871
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# BART's public API is keyless apart from the key parameter, and it publishes one
# demo key in its own API reference for exactly this kind of read. That demo key is
# the default below; set BART_API_KEY to use a key of your own.
BART_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
BART_BASE_URL=https://api.bart.gov/api
BART_API_KEY=MW9S-E7SL-26DU-VV8V
BART_CACHE_TTL=60
BART_LIVE_TTL=60
# The 50-station directory changes a few times a year: cache it for a day.
BART_DIRECTORY_TTL=86400
BART_HTTP_TIMEOUT=20

# --- premium skills (last-departure) -----------------------------------------
# last-departure does not read the board here. It runs on the licence gateway, which
# checks a Polar key before doing the work, so this key is what unlocks it. Every
# other skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
BART_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
BART_DB=./servers/bart/data/tasks.db
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
BART_ALLOW_PRIVATE_WEBHOOKS=0
