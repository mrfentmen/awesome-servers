# World Bank Indicators A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8852
A2A_PUBLIC_URL=http://127.0.0.1:8852
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# The World Bank Indicators API is keyless. Override the User-Agent with your own
# contact; the Bank asks callers to identify themselves.
WORLDBANK_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
WORLDBANK_BASE_URL=https://api.worldbank.org/v2
# WDI is republished on a schedule, so a long cache is honest.
WORLDBANK_CACHE_TTL=3600
WORLDBANK_HTTP_TIMEOUT=20

# --- premium skills (indicator-trend) -----------------------------------------
# indicator-trend does not read the World Bank here. It runs on the licence gateway,
# which checks a Polar key before doing the work, so this key is what unlocks it.
# Every other skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Point at a local `wrangler dev` while testing the gateway.
WORLDBANK_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
WORLDBANK_DB=./servers/worldbank/data/tasks.db
