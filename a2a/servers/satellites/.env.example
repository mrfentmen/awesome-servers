# CelesTrak satellites A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8812
A2A_PUBLIC_URL=http://127.0.0.1:8812
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# CelesTrak is keyless. It throttles bursts, so requests are spaced and cached:
# identify yourself in case they want to contact a heavy caller.
SATELLITES_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
SATELLITES_BASE_URL=https://celestrak.org
# Element sets move every orbit; 5 min is fresh enough for a pass list and keeps
# a burst of questions from tripping CelesTrak's throttle.
SATELLITES_ELEMENT_TTL=300
# The space catalogue only changes on launch, so it is cached for a day.
SATELLITES_CATALOG_TTL=86400
SATELLITES_CACHE_TTL=300
SATELLITES_HTTP_TIMEOUT=25

# --- premium skills (pass-windows) -------------------------------------------
# pass-windows does not propagate anything here. It runs on the licence gateway,
# which checks a Polar key before doing the work, so this key is what unlocks it.
# Every other skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Endpoint override. `a2a_kit.GatewayClient` is constructed with its default
# env prefix, so A2A_GATEWAY_URL is the variable it actually reads; this
# per-server name is here so the setting sits with the rest of this server.
A2A_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp
SATELLITES_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
SATELLITES_DB=./servers/satellites/data/tasks.db
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
SATELLITES_ALLOW_PRIVATE_WEBHOOKS=0
