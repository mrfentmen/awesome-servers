# SpaceDevs launch-schedule A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8813
A2A_PUBLIC_URL=http://127.0.0.1:8813
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# Keyless. The Launch Library allows roughly 30 requests an hour per address and
# answers 429 with a note about when the window reopens, so the schedule is
# cached hard and a 429 is reported in plain words.
LAUNCHES_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
LAUNCHES_BASE_URL=https://ll.thespacedevs.com
LAUNCHES_CACHE_TTL=600
LAUNCHES_HTTP_TIMEOUT=30
# The schedule is republished a few times a day; 10 min keeps it fresh without
# spending the hourly allowance.
LAUNCHES_SCHEDULE_TTL=600
# One launch in full is a much bigger record and changes rarely.
LAUNCHES_DETAIL_TTL=3600

# --- premium skills (launch-board) -------------------------------------------
# launch-board does not page or count anything here. It runs on the licence
# gateway, which checks a Polar key before doing the work, so this key is what
# unlocks it. Every other skill on this server stays free and keyless.
MCP_LICENSE_KEY=
# Endpoint override. `a2a_kit.GatewayClient` is constructed with its default env
# prefix, so A2A_GATEWAY_URL is the variable it actually reads; this per-server
# name is here so the setting sits with the rest of this server.
A2A_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp
LAUNCHES_GATEWAY_URL=https://mcp-gateway.contactae2000.workers.dev/mcp

# --- state -------------------------------------------------------------------
LAUNCHES_DB=./servers/launches/data/tasks.db
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
LAUNCHES_ALLOW_PRIVATE_WEBHOOKS=0
